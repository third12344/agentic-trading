# Smartsheet API access token.
# Generate this from a Smartsheet account that is shared on the sheet as
# "Viewer" only (Sheet > Share). A viewer-level token cannot write to the
# sheet even if this app's code tried to -- Smartsheet itself blocks it.
SMARTSHEET_API_TOKEN=

# The numeric Sheet ID of your "Impact Company" job sheet.
# This is already filled in for "Scheduling - The Impact Company"
# (found via the Smartsheet connector). Change it if you're pointing this
# at a different sheet.
SMARTSHEET_SHEET_ID=2675304775870340

# Only rows with a Project Date on or after this date are imported.
# Keeps the app from pulling in the ~3,000 historical jobs already on the
# sheet. Rows with no date yet (or "first available") are always imported,
# since those are exactly the unassigned work still waiting to be scheduled.
START_DATE=2026-09-20

# How often (minutes) to re-pull the sheet in the background.
SYNC_INTERVAL_MINUTES=15

# Port the app listens on.
PORT=3000

# Set to "true" to run against built-in sample data instead of Smartsheet,
# useful for trying out the UI before credentials are set up.
MOCK_MODE=false
